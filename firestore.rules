rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().active == true;
    }

    function isPrimaryAdmin() {
      return signedIn()
        && request.auth.token.email == 'oticasfascinantes.financeiro@gmail.com';
    }

    function isAdmin() {
      return isPrimaryAdmin()
        || (activeUser() && userProfile().role == 'admin');
    }

    function isManager() {
      return activeUser() && userProfile().role == 'manager';
    }

    function canManageGoals() {
      return isAdmin() || isManager();
    }

    function validGoal(data) {
      return data.keys().hasOnly([
          'title', 'metric', 'targetCount', 'startDate', 'endDate',
          'storeId', 'assigneeUid', 'assigneeName', 'createdByUid',
          'createdByName', 'createdAt', 'groupId', 'schemaVersion'
        ])
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 80
        && data.metric == 'leads_captured'
        && data.targetCount is int
        && data.targetCount >= 1
        && data.targetCount <= 10000
        && data.startDate is string
        && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate is string
        && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate >= data.startDate
        && data.storeId is string
        && data.assigneeUid is string
        && data.assigneeName is string
        && data.assigneeName.size() >= 2
        && data.assigneeName.size() <= 120
        && data.createdByUid == request.auth.uid
        && data.createdByName is string
        && data.groupId is string
        && data.groupId.size() >= 8
        && data.groupId.size() <= 64
        && data.createdAt is timestamp
        && data.schemaVersion == 1;
    }

    function validLead(data) {
      return data.keys().hasOnly([
          'fullName', 'preferredName', 'phone', 'phoneSearch',
          'neighborhood', 'city', 'state', 'interestId', 'interestLabel',
          'appointmentDate', 'appointmentTime', 'notes',
          'consentGiven', 'consentAtClient', 'source',
          'capturedAtClient', 'createdAtServer', 'updatedAtServer',
          'capturedByUid', 'capturedByName', 'storeId', 'installationId',
          'appVersion', 'schemaVersion'
        ])
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && data.phone is string
        && data.phone.size() >= 12
        && data.phone.size() <= 14
        && data.phoneSearch is string
        && data.phoneSearch.size() >= 10
        && data.phoneSearch.size() <= 11
        && data.notes is string
        && data.notes.size() <= 500
        && (!('appointmentDate' in data) || (
          data.appointmentDate is string
          && (data.appointmentDate == '' || data.appointmentDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        ))
        && (!('appointmentTime' in data) || (
          data.appointmentTime is string
          && (data.appointmentTime == '' || data.appointmentTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$'))
        ))
        && (!('appointmentDate' in data) || !('appointmentTime' in data)
          || ((data.appointmentDate == '') == (data.appointmentTime == '')))
        && data.source == 'street'
        && data.schemaVersion == 1;
    }

    match /allowedEmails/{email} {
      allow get: if (signedIn() && request.auth.token.email == email)
        || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && (email != request.auth.token.email || (
          request.resource.data.active == true
          && request.resource.data.role == 'admin'
          && request.resource.data.storeId == userProfile().storeId
        ));
      allow delete: if isAdmin() && email != request.auth.token.email;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId
        || isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email))
        && get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.active == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.role
        && request.resource.data.storeId == get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.storeId;

      allow update: if isAdmin()
        && request.resource.data.email == resource.data.email
        && (userId != request.auth.uid || (
          request.resource.data.active == true
          && request.resource.data.role == resource.data.role
          && request.resource.data.storeId == resource.data.storeId
        ));
      allow delete: if false;
      allow list: if isAdmin()
        || (isManager() && resource.data.storeId == userProfile().storeId);
    }

    match /stores/{storeId} {
      allow get: if isPrimaryAdmin() || (activeUser() && (
        userProfile().storeId == storeId || isAdmin()
      ));
      allow list: if activeUser() || isPrimaryAdmin();
      allow write: if isAdmin();
    }

    match /interests/{interestId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if activeUser()
        && validLead(request.resource.data)
        && request.resource.data.capturedByUid == request.auth.uid
        && request.resource.data.storeId == userProfile().storeId;

      allow get, list: if activeUser() && (
        resource.data.capturedByUid == request.auth.uid
        || (isManager() && resource.data.storeId == userProfile().storeId)
        || isAdmin()
      );

      allow update: if validLead(request.resource.data)
        && request.resource.data.capturedByUid == resource.data.capturedByUid
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.createdAtServer == resource.data.createdAtServer
        && (isAdmin()
          || (activeUser() && resource.data.capturedByUid == request.auth.uid));

      allow delete: if isAdmin();
    }

    match /goals/{goalId} {
      allow get, list: if activeUser() && (
        resource.data.assigneeUid == request.auth.uid
        || (isManager() && resource.data.storeId == userProfile().storeId)
        || isAdmin()
      );

      allow create: if canManageGoals()
        && validGoal(request.resource.data)
        && exists(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.role == 'captor'
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.storeId == request.resource.data.storeId
        && (isAdmin() || request.resource.data.storeId == userProfile().storeId);

      allow update: if false;
      allow delete: if isAdmin()
        || (isManager() && resource.data.storeId == userProfile().storeId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
