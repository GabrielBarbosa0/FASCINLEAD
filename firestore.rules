rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().active == true;
    }

    function isPrimaryAdmin() {
      return signedIn()
        && request.auth.token.email == 'oticasfascinantes.financeiro@gmail.com';
    }

    function isAdmin() {
      return isPrimaryAdmin()
        || (activeUser() && userProfile().role == 'admin');
    }

    function isManager() {
      return activeUser() && userProfile().role == 'manager';
    }

    function managerHasStore(storeId) {
      return isManager() && (
        userProfile().storeId == storeId
        || ('storeIds' in userProfile() && storeId in userProfile().storeIds)
      );
    }

    function canManageGoals() {
      return isAdmin() || isManager();
    }

    function validGoal(data) {
      return data.keys().hasOnly([
          'title', 'metric', 'targetCount', 'startDate', 'endDate',
          'storeId', 'assigneeUid', 'assigneeName', 'createdByUid',
          'createdByName', 'createdAt', 'groupId', 'schemaVersion'
        ])
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 80
        && data.metric == 'leads_captured'
        && data.targetCount is int
        && data.targetCount >= 1
        && data.targetCount <= 10000
        && data.startDate is string
        && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate is string
        && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate >= data.startDate
        && data.storeId is string
        && data.assigneeUid is string
        && data.assigneeName is string
        && data.assigneeName.size() >= 2
        && data.assigneeName.size() <= 120
        && data.createdByUid == request.auth.uid
        && data.createdByName is string
        && data.groupId is string
        && data.groupId.size() >= 8
        && data.groupId.size() <= 64
        && data.createdAt is timestamp
        && data.schemaVersion == 1;
    }

    function validLead(data) {
      return data.keys().hasOnly([
          'fullName', 'preferredName', 'phone', 'phoneSearch',
          'neighborhood', 'city', 'state', 'interestId', 'interestLabel',
          'ametropiaIds', 'ametropiaLabels', 'pathologyIds', 'pathologyLabels',
          'appointmentDate', 'appointmentTime', 'appointmentAttendance',
          'appointmentSchedulingMode', 'appointmentDurationMinutes',
          'appointmentAttendanceUpdatedAt', 'appointmentAttendanceUpdatedByUid', 'notes',
          'followUpContactedAt', 'followUpContactedByUid',
          'followUpContactedByName', 'followUpContactedAppointmentKey',
          'consentGiven', 'consentAtClient', 'source',
          'capturedAtClient', 'createdAtServer', 'updatedAtServer',
          'capturedByUid', 'capturedByName', 'storeId', 'installationId',
          'appVersion', 'schemaVersion'
        ])
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && data.phone is string
        && data.phone.size() >= 12
        && data.phone.size() <= 14
        && data.phoneSearch is string
        && data.phoneSearch.size() >= 10
        && data.phoneSearch.size() <= 11
        && data.notes is string
        && data.notes.size() <= 500
        && (!('ametropiaIds' in data) || (
          data.ametropiaIds is list
          && data.ametropiaIds.size() <= 4
          && data.ametropiaIds.hasOnly(['myopia', 'hyperopia', 'astigmatism', 'presbyopia', 'none', 'unknown'])
          && (!data.ametropiaIds.hasAny(['none', 'unknown']) || data.ametropiaIds.size() == 1)
        ))
        && (!('ametropiaLabels' in data) || (
          data.ametropiaLabels is list
          && data.ametropiaLabels.size() <= 4
          && data.ametropiaLabels.hasOnly(['Miopia', 'Hipermetropia', 'Astigmatismo', 'Presbiopia', 'Nao possui', 'Nao sabe informar'])
        ))
        && (('ametropiaIds' in data) == ('ametropiaLabels' in data))
        && (!('ametropiaIds' in data) || data.ametropiaIds.size() == data.ametropiaLabels.size())
        && (!('pathologyIds' in data) || (
          data.pathologyIds is list
          && data.pathologyIds.size() <= 8
          && data.pathologyIds.hasOnly(['cataract', 'glaucoma', 'diabetes', 'hypertension', 'keratoconus', 'retinopathy', 'dry-eye', 'other', 'none', 'unknown'])
          && (!data.pathologyIds.hasAny(['none', 'unknown']) || data.pathologyIds.size() == 1)
        ))
        && (!('pathologyLabels' in data) || (
          data.pathologyLabels is list
          && data.pathologyLabels.size() <= 8
          && data.pathologyLabels.hasOnly(['Catarata', 'Glaucoma', 'Diabetes', 'Pressao alta', 'Ceratocone', 'Retinopatia', 'Olho seco', 'Outra', 'Nao possui', 'Nao sabe informar'])
        ))
        && (('pathologyIds' in data) == ('pathologyLabels' in data))
        && (!('pathologyIds' in data) || data.pathologyIds.size() == data.pathologyLabels.size())
        && (!('appointmentDate' in data) || (
          data.appointmentDate is string
          && (data.appointmentDate == '' || data.appointmentDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        ))
        && (!('appointmentTime' in data) || (
          data.appointmentTime is string
          && (data.appointmentTime == '' || data.appointmentTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$'))
        ))
        && (!('appointmentDate' in data) || !('appointmentTime' in data)
          || ((data.appointmentDate == '') == (data.appointmentTime == '')))
        && (!('appointmentAttendance' in data)
          || data.appointmentAttendance in ['pending', 'attended', 'missed'])
        && (!('appointmentAttendanceUpdatedAt' in data)
          || data.appointmentAttendanceUpdatedAt is timestamp)
        && (!('appointmentAttendanceUpdatedByUid' in data)
          || data.appointmentAttendanceUpdatedByUid is string)
        && (!('followUpContactedAt' in data)
          || data.followUpContactedAt is timestamp)
        && (!('followUpContactedByUid' in data)
          || (data.followUpContactedByUid is string && data.followUpContactedByUid.size() <= 128))
        && (!('followUpContactedByName' in data)
          || (data.followUpContactedByName is string && data.followUpContactedByName.size() <= 120))
        && (!('followUpContactedAppointmentKey' in data)
          || (data.followUpContactedAppointmentKey is string && data.followUpContactedAppointmentKey.size() <= 32))
        && (!('appointmentSchedulingMode' in data)
          || data.appointmentSchedulingMode in ['controlled', 'free'])
        && (!('appointmentDurationMinutes' in data)
          || (data.appointmentDurationMinutes is int
            && data.appointmentDurationMinutes >= 5
            && data.appointmentDurationMinutes <= 180))
        && data.source == 'street'
        && data.schemaVersion == 1;
    }

    function validAppointmentSlot(slotId, data) {
      return data.keys().hasOnly([
          'storeId', 'appointmentDate', 'appointmentTime', 'durationMinutes',
          'leadId', 'capturedByUid', 'createdAt'
        ])
        && data.storeId is string
        && data.appointmentDate is string
        && data.appointmentDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.appointmentTime is string
        && data.appointmentTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$')
        && data.durationMinutes is int
        && data.durationMinutes >= 5
        && data.durationMinutes <= 180
        && data.leadId is string
        && data.capturedByUid is string
        && data.createdAt is timestamp
        && slotId == 'slot-' + data.storeId + '-' + data.appointmentDate + '-' + data.appointmentTime;
    }

    function isCaptorLeadCorrection() {
      return activeUser()
        && resource.data.capturedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'preferredName', 'phone', 'phoneSearch',
          'neighborhood', 'city', 'state', 'interestId', 'interestLabel',
          'ametropiaIds', 'ametropiaLabels', 'pathologyIds', 'pathologyLabels',
          'appointmentDate', 'appointmentTime', 'appointmentSchedulingMode',
          'appointmentDurationMinutes', 'appointmentAttendance', 'notes', 'updatedAtServer'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['appointmentAttendance'])
          || (
            request.resource.data.appointmentAttendance == 'pending'
            && resource.data.appointmentAttendance == 'missed'
            && (
              request.resource.data.appointmentDate != resource.data.appointmentDate
              || request.resource.data.appointmentTime != resource.data.appointmentTime
            )
          ));
    }

    function isManagerAttendanceUpdate() {
      return isManager()
        && managerHasStore(resource.data.storeId)
        && resource.data.appointmentDate is string
        && resource.data.appointmentDate != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'appointmentAttendance', 'appointmentAttendanceUpdatedAt',
          'appointmentAttendanceUpdatedByUid', 'updatedAtServer'
        ]);
    }

    function isCaptorFollowUpContactUpdate() {
      return activeUser()
        && userProfile().role == 'captor'
        && resource.data.capturedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'followUpContactedAt', 'followUpContactedByUid',
          'followUpContactedByName', 'followUpContactedAppointmentKey',
          'updatedAtServer'
        ])
        && request.resource.data.followUpContactedByUid == request.auth.uid
        && request.resource.data.followUpContactedByName == userProfile().displayName
        && request.resource.data.followUpContactedAppointmentKey
          == resource.data.appointmentDate + '|' + resource.data.appointmentTime;
    }

    match /allowedEmails/{email} {
      allow get: if (signedIn() && request.auth.token.email == email)
        || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && (email != request.auth.token.email || (
          request.resource.data.active == true
          && request.resource.data.role == 'admin'
          && request.resource.data.storeId == userProfile().storeId
          && (!('storeIds' in resource.data) || request.resource.data.storeIds == resource.data.storeIds)
        ));
      allow delete: if isAdmin() && email != request.auth.token.email;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId
        || isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email))
        && get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.active == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.role
        && request.resource.data.storeId == get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.storeId
        && (!('storeIds' in get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data)
          || request.resource.data.storeIds == get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.storeIds);

      allow update: if isAdmin()
        && request.resource.data.email == resource.data.email
        && (userId != request.auth.uid || (
          request.resource.data.active == true
          && request.resource.data.role == resource.data.role
          && request.resource.data.storeId == resource.data.storeId
          && (!('storeIds' in resource.data) || request.resource.data.storeIds == resource.data.storeIds)
        ));
      allow delete: if false;
      allow list: if isAdmin()
        || managerHasStore(resource.data.storeId);
    }

    match /stores/{storeId} {
      allow get: if isPrimaryAdmin() || (activeUser() && (
        userProfile().storeId == storeId || managerHasStore(storeId) || isAdmin()
      ));
      allow list: if activeUser() || isPrimaryAdmin();
      allow write: if isAdmin();
    }

    match /interests/{interestId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if activeUser()
        && validLead(request.resource.data)
        && request.resource.data.capturedByUid == request.auth.uid
        && (isAdmin()
          || request.resource.data.storeId == userProfile().storeId
          || managerHasStore(request.resource.data.storeId));

      allow get, list: if activeUser() && (
        resource.data.capturedByUid == request.auth.uid
        || managerHasStore(resource.data.storeId)
        || isAdmin()
      );

      allow update: if validLead(request.resource.data)
        && request.resource.data.capturedByUid == resource.data.capturedByUid
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.createdAtServer == resource.data.createdAtServer
        && (isAdmin() || isCaptorLeadCorrection() || isManagerAttendanceUpdate() || isCaptorFollowUpContactUpdate());

      allow delete: if isAdmin();
    }

    match /appointmentSlots/{slotId} {
      allow get, list: if activeUser() && (
        resource.data.storeId == userProfile().storeId || managerHasStore(resource.data.storeId) || isAdmin()
      );
      allow create: if activeUser()
        && validAppointmentSlot(slotId, request.resource.data)
        && (isAdmin() || managerHasStore(request.resource.data.storeId) || (
          request.resource.data.storeId == userProfile().storeId
          && request.resource.data.capturedByUid == request.auth.uid
        ))
        && existsAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId))
        && getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.storeId == request.resource.data.storeId
        && getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.appointmentDate == request.resource.data.appointmentDate
        && getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.appointmentTime == request.resource.data.appointmentTime
        && getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.capturedByUid == request.resource.data.capturedByUid;
      allow update: if false;
      allow delete: if isAdmin()
        || (activeUser()
          && resource.data.capturedByUid == request.auth.uid
          && (
            !existsAfter(/databases/$(database)/documents/leads/$(resource.data.leadId))
            || getAfter(/databases/$(database)/documents/leads/$(resource.data.leadId)).data.appointmentDate != resource.data.appointmentDate
            || getAfter(/databases/$(database)/documents/leads/$(resource.data.leadId)).data.appointmentTime != resource.data.appointmentTime
          ));
    }

    match /goals/{goalId} {
      allow get, list: if activeUser() && (
        resource.data.assigneeUid == request.auth.uid
        || managerHasStore(resource.data.storeId)
        || isAdmin()
      );

      allow create: if canManageGoals()
        && validGoal(request.resource.data)
        && exists(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.role == 'captor'
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.storeId == request.resource.data.storeId
        && (isAdmin() || managerHasStore(request.resource.data.storeId));

      allow update: if false;
      allow delete: if isAdmin()
        || managerHasStore(resource.data.storeId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
