rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().active == true;
    }

    function isPrimaryAdmin() {
      return signedIn()
        && request.auth.token.email == 'oticasfascinantes.financeiro@gmail.com';
    }

    function isAdmin() {
      return isPrimaryAdmin()
        || (activeUser() && userProfile().role == 'admin');
    }

    function isManager() {
      return activeUser() && userProfile().role == 'manager';
    }

    function legacyPermission(permission) {
      return permission in ['leads.create', 'leads.view_own', 'leads.edit_own', 'followups.own', 'goals.view_own']
        || (userProfile().role == 'manager' && permission in [
          'management.view', 'appointments.view', 'appointments.attendance',
          'followups.team', 'goals.manage', 'dashboard.view', 'leads.export'
        ]);
    }

    function hasPermission(permission) {
      return isPrimaryAdmin() || (activeUser() && (
        userProfile().role == 'admin'
        || (('permissions' in userProfile()) && permission in userProfile().permissions)
        || (!('permissions' in userProfile()) && legacyPermission(permission))
      ));
    }

    function managerHasStore(storeId) {
      return isManager() && (
        userProfile().storeId == storeId
        || ('storeIds' in userProfile() && storeId in userProfile().storeIds)
      );
    }

    function userHasStore(storeId) {
      return activeUser() && (
        userProfile().storeId == storeId
        || ('storeIds' in userProfile() && storeId in userProfile().storeIds)
      );
    }

    function isSurubimSharedStore(storeId) {
      return storeId in ['loja-02', 'loja-06'];
    }

    function userHasScheduleStore(storeId) {
      return userHasStore(storeId)
        || (isSurubimSharedStore(storeId) && (
          userHasStore('loja-02') || userHasStore('loja-06')
        ));
    }

    function managerHasScheduleStore(storeId) {
      return managerHasStore(storeId)
        || (isSurubimSharedStore(storeId) && (
          managerHasStore('loja-02') || managerHasStore('loja-06')
        ));
    }

    function appointmentResourceId(storeId) {
      return isSurubimSharedStore(storeId) ? 'consultorio-surubim' : storeId;
    }

    function permittedStoreIds() {
      return ('storeIds' in userProfile()) ? userProfile().storeIds : [userProfile().storeId];
    }

    function canManageGoals() {
      return hasPermission('goals.manage');
    }

    function validGoal(data) {
      return data.keys().hasOnly([
          'title', 'metric', 'targetCount', 'startDate', 'endDate',
          'storeId', 'assigneeUid', 'assigneeName', 'createdByUid',
          'createdByName', 'createdAt', 'groupId', 'schemaVersion'
        ])
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 80
        && data.metric == 'leads_captured'
        && data.targetCount is int
        && data.targetCount >= 1
        && data.targetCount <= 10000
        && data.startDate is string
        && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate is string
        && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate >= data.startDate
        && data.storeId is string
        && data.assigneeUid is string
        && data.assigneeName is string
        && data.assigneeName.size() >= 2
        && data.assigneeName.size() <= 120
        && data.createdByUid is string
        && data.createdByName is string
        && data.groupId is string
        && data.groupId.size() >= 8
        && data.groupId.size() <= 64
        && data.createdAt is timestamp
        && data.schemaVersion == 1;
    }

    function validLead(data) {
      return data.keys().hasOnly([
          'fullName', 'preferredName', 'phone', 'phoneSearch',
          'customerCpf', 'customerRg', 'birthDate', 'birthMonthDay', 'sex',
          'street', 'streetNumber', 'neighborhood', 'city', 'state', 'addressReference', 'interestId', 'interestLabel',
          'ametropiaIds', 'ametropiaLabels', 'pathologyIds', 'pathologyLabels', 'diabetesLevel', 'diabetesNeedsMedicalAlert',
          'eyeSurgeryStatus', 'eyeSurgeryType', 'eyeSurgeryDetails',
          'careRoute', 'careRouteOverride', 'careRouteReasons',
          'examPaymentType', 'examPaymentMethods', 'examPrice',
          'needsTransport', 'hasCompanion', 'companionCount', 'transportSeats',
          'appointmentDate', 'appointmentTime', 'appointmentAttendance',
          'funnelStage', 'funnelReasonCode', 'funnelUpdatedAtClient', 'funnelUpdatedAtServer', 'appointmentCycle',
          'appointmentSchedulingMode', 'appointmentDurationMinutes',
          'appointmentServiceId', 'appointmentServiceName',
          'notes',
          'consentGiven', 'consentAtClient', 'source',
          'capturedAtClient', 'createdAtServer', 'updatedAtServer',
          'capturedByUid', 'capturedByName', 'storeId', 'installationId',
          'appVersion', 'schemaVersion'
        ])
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && data.phone is string
        && data.phone.size() >= 12
        && data.phone.size() <= 14
        && data.phoneSearch is string
        && data.phoneSearch.size() >= 10
        && data.phoneSearch.size() <= 11
        && (!('customerCpf' in data) || (
          data.customerCpf is string
          && (data.customerCpf == '' || data.customerCpf.matches('^\\d{11}$'))
        ))
        && (!('customerRg' in data) || (data.customerRg is string && data.customerRg.size() <= 20))
        && (!('addressReference' in data) || (data.addressReference is string && data.addressReference.size() <= 160))
        && (!('examPrice' in data) || (data.examPrice is number && data.examPrice >= 0 && data.examPrice <= 100000))
        && data.birthDate is string
        && data.birthDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('birthMonthDay' in data) || (data.birthMonthDay is string
          && data.birthMonthDay.matches('^\\d{2}-\\d{2}$')))
        && (!('needsTransport' in data) || data.needsTransport is bool)
        && (!('hasCompanion' in data) || data.hasCompanion is bool)
        && (!('companionCount' in data) || (data.companionCount is int
          && data.companionCount >= 0 && data.companionCount <= 5))
        && (!('transportSeats' in data) || (data.transportSeats is int
          && data.transportSeats >= 0 && data.transportSeats <= 6))
        && (!('needsTransport' in data) || !('hasCompanion' in data) || data.needsTransport || !data.hasCompanion)
        && (!('needsTransport' in data) || !('transportSeats' in data) || !('hasCompanion' in data)
          || data.transportSeats == (data.needsTransport
            ? (('companionCount' in data) ? data.companionCount + 1 : (data.hasCompanion ? 2 : 1))
            : 0))
        && (!('companionCount' in data) || !('hasCompanion' in data)
          || data.hasCompanion == (data.companionCount > 0))
        && data.notes is string
        && data.notes.size() <= 500
        && (!('appointmentDate' in data) || (
          data.appointmentDate is string
          && (data.appointmentDate == '' || data.appointmentDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        ))
        && (!('appointmentTime' in data) || (
          data.appointmentTime is string
          && (data.appointmentTime == '' || data.appointmentTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$'))
        ))
        && (!('appointmentDate' in data) || !('appointmentTime' in data)
          || ((data.appointmentDate == '') == (data.appointmentTime == '')))
        && (!('appointmentAttendance' in data)
          || data.appointmentAttendance in ['pending', 'attended', 'missed'])
        && (!('appointmentSchedulingMode' in data)
          || data.appointmentSchedulingMode in ['controlled', 'free'])
        && (!('appointmentDurationMinutes' in data)
          || (data.appointmentDurationMinutes is int
            && data.appointmentDurationMinutes >= 5
            && data.appointmentDurationMinutes <= 180))
        && (!('appointmentServiceId' in data)
          || (data.appointmentServiceId is string
            && data.appointmentServiceId.size() >= 1
            && data.appointmentServiceId.size() <= 120))
        && (!('appointmentServiceName' in data)
          || (data.appointmentServiceName is string
            && data.appointmentServiceName.size() >= 2
            && data.appointmentServiceName.size() <= 80))
        && (!('examPaymentType' in data) || data.examPaymentType in ['paid', 'courtesy'])
        && (!('examPaymentMethods' in data) || (data.examPaymentMethods is list
          && data.examPaymentMethods.size() <= 6
          && data.examPaymentMethods.hasOnly(['cash', 'pix', 'debit-card', 'credit-card', 'bank-slip', 'other'])))
        && (!('examPaymentMethods' in data) || !('examPaymentType' in data)
          || data.examPaymentType == 'paid' || data.examPaymentMethods.size() == 0)
        && data.source == 'street'
        && data.schemaVersion == 1;
    }

    function validLeadHistory(data) {
      return data.keys().hasOnly([
          'leadId', 'storeId', 'eventType', 'funnelStage', 'reasonCode',
          'benefitType', 'benefitValue', 'benefitLabel',
          'actorUid', 'actorName', 'actorRole', 'occurredAtClient',
          'occurredAtServer', 'schemaVersion'
        ])
        && data.leadId is string
        && data.storeId is string
        && data.eventType in [
          'lead_created', 'appointment_scheduled', 'appointment_rescheduled',
          'appointment_cancelled', 'appointment_reminder_sent',
          'appointment_attended', 'appointment_missed', 'follow_up_contacted',
          'birthday_benefit_planned', 'birthday_congratulated'
        ]
        && data.funnelStage in [
          'captured', 'awaiting_appointment', 'scheduled', 'confirmation',
          'confirmed', 'attended', 'missed', 'awaiting_reschedule',
          'cancelled', 'closed'
        ]
        && data.reasonCode is string
        && data.reasonCode.size() <= 64
        && (!('benefitType' in data) || data.benefitType in ['voucher', 'cashback'])
        && (!('benefitValue' in data) || (data.benefitValue is number
          && data.benefitValue >= 0 && data.benefitValue <= 100000))
        && (!('benefitLabel' in data) || (data.benefitLabel is string && data.benefitLabel.size() <= 80))
        && data.actorUid is string
        && data.actorName is string
        && data.actorName.size() >= 2
        && data.actorName.size() <= 120
        && data.actorRole is string
        && data.actorRole.size() <= 40
        && data.occurredAtClient is string
        && data.occurredAtClient.size() <= 40
        && data.occurredAtServer is timestamp
        && data.schemaVersion == 1;
    }

    function canReadLeadHistory(leadId) {
      return activeUser()
        && exists(/databases/$(database)/documents/leads/$(leadId))
        && (
          (get(/databases/$(database)/documents/leads/$(leadId)).data.capturedByUid == request.auth.uid
            && hasPermission('leads.view_own'))
          || (managerHasStore(get(/databases/$(database)/documents/leads/$(leadId)).data.storeId)
            && hasPermission('management.view'))
          || (managerHasStore(get(/databases/$(database)/documents/leads/$(leadId)).data.storeId)
            && hasPermission('appointments.view'))
          || isAdmin()
        );
    }

    function validAppointmentService(data) {
      return data.keys().hasOnly([
          'name', 'storeIds', 'durationMinutes', 'active', 'schemaVersion',
          'createdAt', 'createdByUid', 'updatedAt', 'updatedByUid'
        ])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 80
        && data.storeIds is list
        && data.storeIds.size() >= 1
        && data.storeIds.size() <= 4
        && data.storeIds.hasOnly(['loja-02', 'loja-04', 'loja-05', 'loja-06'])
        && data.durationMinutes is int
        && data.durationMinutes >= 10
        && data.durationMinutes <= 180
        && data.durationMinutes % 10 == 0
        && data.active is bool
        && data.schemaVersion == 2
        && data.createdAt is timestamp
        && data.createdByUid is string
        && data.updatedAt is timestamp
        && data.updatedByUid == request.auth.uid;
    }

    function validAppointmentSlot(slotId, data) {
      return data.keys().hasOnly([
          'storeId', 'appointmentDate', 'appointmentTime', 'blockTime', 'durationMinutes',
          'leadId', 'capturedByUid', 'createdAt'
        ])
        && data.storeId is string
        && data.appointmentDate is string
        && data.appointmentDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.appointmentTime is string
        && data.appointmentTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$')
        && data.blockTime is string
        && data.blockTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$')
        && data.durationMinutes is int
        && data.durationMinutes >= 10
        && data.durationMinutes <= 180
        && data.leadId is string
        && data.capturedByUid is string
        && data.createdAt is timestamp
        && slotId == 'slot-' + appointmentResourceId(data.storeId) + '-' + data.appointmentDate + '-' + data.blockTime;
    }

    function validCaptorCorrectionData(data) {
      return data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && data.phone is string
        && data.phone.size() >= 12
        && data.phone.size() <= 14
        && data.phoneSearch is string
        && data.phoneSearch.matches('^\\d{10,11}$')
        && (!('customerCpf' in data) || (data.customerCpf is string
          && (data.customerCpf == '' || data.customerCpf.matches('^\\d{11}$'))))
        && (!('customerRg' in data) || (data.customerRg is string && data.customerRg.size() <= 20))
        && (!('birthDate' in data) || (data.birthDate is string
          && (data.birthDate == '' || data.birthDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))))
        && (!('sex' in data) || (data.sex is string && data.sex in ['', 'female', 'male']))
        && (!('eyeSurgeryStatus' in data) || data.eyeSurgeryStatus in ['', 'yes', 'no', 'unknown'])
        && (!('eyeSurgeryType' in data) || data.eyeSurgeryType in ['', 'cataract', 'refractive', 'corneal-transplant', 'other'])
        && (!('eyeSurgeryDetails' in data) || (data.eyeSurgeryDetails is string && data.eyeSurgeryDetails.size() <= 120))
        && (!('careRoute' in data) || data.careRoute in ['optometrist', 'ophthalmologist'])
        && (!('careRouteOverride' in data) || data.careRouteOverride in ['automatic', 'optometrist', 'ophthalmologist'])
        && (!('careRouteReasons' in data) || (data.careRouteReasons is list
          && data.careRouteReasons.hasOnly(['pathology', 'surgery', 'manual'])))
        && (!('examPrice' in data) || (data.examPrice is number && data.examPrice >= 0 && data.examPrice <= 100000))
        && (!('needsTransport' in data) || data.needsTransport is bool)
        && (!('hasCompanion' in data) || data.hasCompanion is bool)
        && (!('companionCount' in data) || (data.companionCount is int
          && data.companionCount >= 0 && data.companionCount <= 5))
        && (!('transportSeats' in data) || (data.transportSeats is int
          && data.transportSeats >= 0 && data.transportSeats <= 6))
        && (!('needsTransport' in data) || !('hasCompanion' in data) || data.needsTransport || !data.hasCompanion)
        && (!('needsTransport' in data) || !('hasCompanion' in data) || !('transportSeats' in data)
          || data.transportSeats == (data.needsTransport
            ? (('companionCount' in data) ? data.companionCount + 1 : (data.hasCompanion ? 2 : 1))
            : 0))
        && (!('companionCount' in data) || !('hasCompanion' in data)
          || data.hasCompanion == (data.companionCount > 0))
        && (!('street' in data) || (data.street is string && data.street.size() <= 120))
        && (!('streetNumber' in data) || (data.streetNumber is string && data.streetNumber.size() <= 12))
        && (!('addressReference' in data) || (data.addressReference is string && data.addressReference.size() <= 160))
        && data.notes is string
        && data.notes.size() <= 500
        && (!('ametropiaIds' in data) || (data.ametropiaIds is list
          && data.ametropiaIds.size() <= 4
          && data.ametropiaIds.hasOnly(['myopia', 'hyperopia', 'astigmatism', 'presbyopia', 'none', 'unknown'])
          && (!data.ametropiaIds.hasAny(['none', 'unknown']) || data.ametropiaIds.size() == 1)))
        && (!('pathologyIds' in data) || (data.pathologyIds is list
          && data.pathologyIds.size() <= 10
          && data.pathologyIds.hasOnly(['cataract', 'glaucoma', 'diabetes', 'hypertension', 'keratoconus', 'retinopathy', 'dry-eye', 'macular-degeneration', 'retinal-detachment', 'other', 'none', 'unknown'])
          && (!data.pathologyIds.hasAny(['none', 'unknown']) || data.pathologyIds.size() == 1)))
        && (!('appointmentDate' in data) || data.appointmentDate == ''
          || data.appointmentDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && (!('appointmentTime' in data) || data.appointmentTime == ''
          || data.appointmentTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$'))
        && (!('appointmentAttendance' in data)
          || data.appointmentAttendance in ['pending', 'attended', 'missed'])
        && (!('appointmentSchedulingMode' in data)
          || data.appointmentSchedulingMode in ['controlled', 'free'])
        && (!('appointmentDurationMinutes' in data)
          || (data.appointmentDurationMinutes is int
            && data.appointmentDurationMinutes >= 5
            && data.appointmentDurationMinutes <= 180))
        && (!('appointmentServiceId' in data)
          || (data.appointmentServiceId is string && data.appointmentServiceId.size() <= 120))
        && (!('appointmentServiceName' in data)
          || (data.appointmentServiceName is string && data.appointmentServiceName.size() <= 80));
    }

    function validLeadSale(leadId, data) {
      return data.keys().hasOnly([
          'leadId', 'storeId', 'capturedByUid', 'customerCpf',
          'purchaseInterest', 'matchStatus', 'savwinStoreCode',
          'savwinOsNumber', 'savwinSaleCode', 'savwinCustomerCode',
          'savwinSaleDate', 'savwinSaleValue', 'createdByUid',
          'createdAt', 'updatedByUid', 'updatedAt', 'schemaVersion'
        ])
        && data.leadId == leadId
        && data.storeId is string
        && data.capturedByUid is string
        && data.customerCpf is string
        && data.customerCpf.matches('^\\d{11}$')
        && data.purchaseInterest == true
        && data.matchStatus in ['interest_registered', 'sale_linked']
        && data.savwinStoreCode is string
        && data.savwinOsNumber is string
        && data.savwinSaleCode is string
        && data.savwinCustomerCode is string
        && data.savwinSaleDate is string
        && (data.savwinSaleDate == '' || data.savwinSaleDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && data.savwinSaleValue is number
        && data.savwinSaleValue >= 0
        && data.createdByUid is string
        && data.createdAt is timestamp
        && data.updatedByUid == request.auth.uid
        && data.updatedAt is timestamp
        && data.schemaVersion == 1;
    }

    function isCaptorLeadCorrection() {
      return activeUser()
        && resource.data.capturedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'preferredName', 'phone', 'phoneSearch',
          'customerCpf', 'customerRg', 'birthDate', 'birthMonthDay', 'sex',
          'street', 'streetNumber', 'neighborhood', 'city', 'state', 'addressReference', 'interestId', 'interestLabel',
          'ametropiaIds', 'ametropiaLabels', 'pathologyIds', 'pathologyLabels', 'diabetesLevel', 'diabetesNeedsMedicalAlert',
          'eyeSurgeryStatus', 'eyeSurgeryType', 'eyeSurgeryDetails',
          'careRoute', 'careRouteOverride', 'examPaymentType', 'examPaymentMethods', 'examPrice',
          'needsTransport', 'hasCompanion', 'companionCount', 'transportSeats',
          'appointmentDate', 'appointmentTime', 'appointmentSchedulingMode',
          'appointmentDurationMinutes', 'appointmentServiceId', 'appointmentServiceName',
          'appointmentAttendance', 'notes', 'updatedAtServer'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['appointmentAttendance'])
          || (
            request.resource.data.appointmentAttendance == 'pending'
            && (
              !('appointmentAttendance' in resource.data)
              || resource.data.appointmentAttendance == 'missed'
            )
            && (
              request.resource.data.appointmentDate != resource.data.appointmentDate
              || request.resource.data.appointmentTime != resource.data.appointmentTime
            )
          ));
    }

    function isOwnerAppointmentUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'appointmentDate', 'appointmentTime', 'appointmentSchedulingMode',
          'appointmentDurationMinutes', 'appointmentServiceId', 'appointmentServiceName',
          'appointmentAttendance', 'updatedAtServer'
        ])
        && resource.data.capturedByUid == request.auth.uid
        && request.resource.data.appointmentDate != ''
        && request.resource.data.appointmentTime != ''
        && request.resource.data.appointmentAttendance == 'pending'
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['appointmentAttendance'])
          || (
            (!('appointmentAttendance' in resource.data)
              || resource.data.appointmentAttendance == 'missed')
            && (
              request.resource.data.appointmentDate != resource.data.appointmentDate
              || request.resource.data.appointmentTime != resource.data.appointmentTime
            )
          ))
        && activeUser()
        && hasPermission('leads.create')
        && userHasStore(resource.data.storeId);
    }

    function validAppointmentReminder(data) {
      return data.keys().hasOnly([
          'leadId', 'storeId', 'appointmentDate', 'appointmentTime',
          'appointmentKey', 'completedAt', 'completedByUid',
          'completedByName', 'schemaVersion'
        ])
        && data.leadId is string
        && data.leadId.size() >= 1
        && data.storeId is string
        && data.appointmentDate is string
        && data.appointmentDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.appointmentTime is string
        && data.appointmentTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$')
        && data.appointmentKey == data.appointmentDate + '|' + data.appointmentTime
        && data.completedAt is timestamp
        && data.completedByUid == request.auth.uid
        && data.completedByName == userProfile().displayName
        && data.schemaVersion == 1;
    }

    function isManagerLeadUpdate() {
      return (isAdmin() || (isManager() && managerHasStore(resource.data.storeId)))
        && (!('appointmentDate' in request.resource.data)
          || request.resource.data.appointmentDate == ''
          || request.resource.data.appointmentDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && (!('appointmentTime' in request.resource.data)
          || request.resource.data.appointmentTime == ''
          || request.resource.data.appointmentTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$'))
        && (!('appointmentAttendance' in request.resource.data)
          || request.resource.data.appointmentAttendance in ['pending', 'attended', 'missed'])
        && (
          (
            hasPermission('appointments.attendance')
            &&
            resource.data.appointmentDate is string
            && resource.data.appointmentDate != ''
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'appointmentAttendance', 'appointmentAttendanceUpdatedAt',
              'appointmentAttendanceUpdatedByUid', 'updatedAtServer'
            ])
          )
          || (
            hasPermission('followups.team')
            &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'followUpContactedAt', 'followUpContactedByUid',
              'followUpContactedByName', 'followUpContactedAppointmentKey',
              'updatedAtServer'
            ])
            && request.resource.data.followUpContactedByUid == request.auth.uid
            && request.resource.data.followUpContactedByName == userProfile().displayName
            && request.resource.data.followUpContactedAppointmentKey
              == resource.data.appointmentDate + '|' + resource.data.appointmentTime
          )
          || (hasPermission('appointments.attendance')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'appointmentDate', 'appointmentTime', 'appointmentSchedulingMode',
              'appointmentDurationMinutes', 'appointmentServiceId', 'appointmentServiceName',
              'appointmentAttendance', 'updatedAtServer'
            ]))
          || (hasPermission('leads.clinical_update')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'pathologyIds', 'pathologyLabels', 'diabetesLevel', 'diabetesNeedsMedicalAlert',
              'eyeSurgeryStatus', 'eyeSurgeryType', 'eyeSurgeryDetails',
              'careRoute', 'careRouteOverride', 'examPrice', 'updatedAtServer'
            ]))
        );
    }

    function isCaptorFollowUpContactUpdate() {
      return activeUser()
        && resource.data.capturedByUid == request.auth.uid
        && (
          userProfile().roleProfileId == 'system-receptionist'
          || hasPermission('followups.own')
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'followUpContactedAt', 'followUpContactedByUid',
          'followUpContactedByName', 'followUpContactedAppointmentKey',
          'updatedAtServer'
        ])
        && request.resource.data.followUpContactedByUid == request.auth.uid
        && request.resource.data.followUpContactedByName == userProfile().displayName
        && request.resource.data.followUpContactedAt is timestamp
        && request.resource.data.followUpContactedAppointmentKey is string
        && request.resource.data.followUpContactedAppointmentKey
          == resource.data.appointmentDate + '|' + resource.data.appointmentTime;
    }

    function isAdminLeadCorrection() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'preferredName', 'phone', 'phoneSearch', 'customerCpf', 'customerRg', 'birthDate', 'birthMonthDay', 'sex',
          'street', 'streetNumber', 'neighborhood', 'city', 'state', 'addressReference', 'interestId', 'interestLabel',
          'ametropiaIds', 'ametropiaLabels', 'pathologyIds', 'pathologyLabels', 'diabetesLevel', 'diabetesNeedsMedicalAlert',
          'eyeSurgeryStatus', 'eyeSurgeryType', 'eyeSurgeryDetails',
          'careRoute', 'careRouteOverride', 'examPaymentType', 'examPaymentMethods', 'examPrice',
          'needsTransport', 'hasCompanion', 'companionCount', 'transportSeats',
          'appointmentDate', 'appointmentTime', 'appointmentSchedulingMode',
          'appointmentDurationMinutes', 'appointmentServiceId', 'appointmentServiceName',
          'appointmentAttendance', 'notes', 'updatedAtServer'
        ]);
    }

    match /allowedEmails/{email} {
      allow get: if (signedIn() && request.auth.token.email == email)
        || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && (email != request.auth.token.email || (
          request.resource.data.active == true
          && request.resource.data.role == 'admin'
          && request.resource.data.storeId == userProfile().storeId
          && (!('storeIds' in resource.data) || request.resource.data.storeIds == resource.data.storeIds)
        ));
      allow delete: if isAdmin() && email != request.auth.token.email;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId
        || isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email))
        && get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.active == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.role
        && (!('roleProfileId' in get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data)
          || request.resource.data.roleProfileId == get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.roleProfileId)
        && (!('permissions' in get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data)
          || request.resource.data.permissions == get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.permissions)
        && request.resource.data.storeId == get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.storeId
        && (!('storeIds' in get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data)
          || request.resource.data.storeIds == get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.storeIds);

      allow update: if isAdmin()
        && request.resource.data.email == resource.data.email
        && (userId != request.auth.uid || (
          request.resource.data.active == true
          && request.resource.data.role == resource.data.role
          && request.resource.data.storeId == resource.data.storeId
          && (!('storeIds' in resource.data) || request.resource.data.storeIds == resource.data.storeIds)
        ));
      allow delete: if false;
      allow list: if isAdmin()
        || managerHasStore(resource.data.storeId);
    }

    match /roleProfiles/{roleProfileId} {
      allow get: if activeUser();
      allow list, create, update, delete: if isAdmin();
    }

    match /stores/{storeId} {
      allow get: if isPrimaryAdmin() || (activeUser() && (
        userHasScheduleStore(storeId) || managerHasScheduleStore(storeId) || isAdmin()
      ));
      allow list: if activeUser() || isPrimaryAdmin();
      allow write: if isAdmin();
    }

    match /interests/{interestId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /appointmentServices/{serviceId} {
      allow get, list: if isAdmin() || (activeUser()
        && resource.data.active == true
        && resource.data.storeIds.hasAny(permittedStoreIds()));
      allow create: if isAdmin()
        && validAppointmentService(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isAdmin()
        && validAppointmentService(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if activeUser()
        && hasPermission('leads.create')
        && validLead(request.resource.data)
        && request.resource.data.capturedByUid == request.auth.uid
        && (isAdmin() || userHasStore(request.resource.data.storeId));

      allow get, list: if activeUser() && (
        (resource.data.capturedByUid == request.auth.uid && hasPermission('leads.view_own'))
        || (managerHasStore(resource.data.storeId) && hasPermission('management.view'))
        || (managerHasStore(resource.data.storeId) && hasPermission('appointments.view'))
        || isAdmin()
      );

      allow update: if request.resource.data.capturedByUid == resource.data.capturedByUid
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.createdAtServer == resource.data.createdAtServer
        && (
          (
            resource.data.capturedByUid == request.auth.uid
            && (
              isCaptorFollowUpContactUpdate()
              || isOwnerAppointmentUpdate()
              || (
                isCaptorLeadCorrection()
                && (!('permissions' in userProfile()) || 'leads.edit_own' in userProfile().permissions)
                && validCaptorCorrectionData(request.resource.data)
              )
            )
          )
          || isAdminLeadCorrection()
          || isManagerLeadUpdate()
        );

      allow delete: if isPrimaryAdmin()
        || (activeUser()
          && hasPermission('leads.delete')
          && (isAdmin()
            || resource.data.capturedByUid == request.auth.uid
            || managerHasStore(resource.data.storeId)));

      match /history/{historyId} {
        allow get, list: if canReadLeadHistory(leadId);
        allow create: if activeUser()
          && validLeadHistory(request.resource.data)
          && request.resource.data.leadId == leadId
          && request.resource.data.actorUid == request.auth.uid
          && existsAfter(/databases/$(database)/documents/leads/$(leadId))
          && getAfter(/databases/$(database)/documents/leads/$(leadId)).data.storeId == request.resource.data.storeId
          && (
            isAdmin()
            || (getAfter(/databases/$(database)/documents/leads/$(leadId)).data.capturedByUid == request.auth.uid
              && hasPermission('leads.create'))
            || (managerHasStore(getAfter(/databases/$(database)/documents/leads/$(leadId)).data.storeId)
              && hasPermission('management.view'))
          );
        allow update, delete: if false;
      }
    }

    match /leadSales/{leadId} {
      allow get: if isAdmin() || (isManager()
        && exists(/databases/$(database)/documents/leads/$(leadId))
        && managerHasStore(get(/databases/$(database)/documents/leads/$(leadId)).data.storeId));
      allow list: if isAdmin() || managerHasStore(resource.data.storeId);
      allow create: if validLeadSale(leadId, request.resource.data)
        && (isAdmin() || managerHasStore(request.resource.data.storeId))
        && exists(/databases/$(database)/documents/leads/$(leadId))
        && get(/databases/$(database)/documents/leads/$(leadId)).data.storeId == request.resource.data.storeId
        && get(/databases/$(database)/documents/leads/$(leadId)).data.capturedByUid == request.resource.data.capturedByUid;
      allow update: if validLeadSale(leadId, request.resource.data)
        && (isAdmin() || managerHasStore(resource.data.storeId))
        && request.resource.data.leadId == resource.data.leadId
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.capturedByUid == resource.data.capturedByUid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /appointmentSlots/{slotId} {
      allow get, list: if activeUser() && (
        (userHasScheduleStore(resource.data.storeId) && hasPermission('leads.create'))
        || (managerHasScheduleStore(resource.data.storeId) && hasPermission('appointments.view'))
        || isAdmin()
      );
      allow create: if activeUser()
        && validAppointmentSlot(slotId, request.resource.data)
        && (isAdmin() || managerHasStore(request.resource.data.storeId) || (
          userHasStore(request.resource.data.storeId)
          && request.resource.data.capturedByUid == request.auth.uid
        ))
        && existsAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId))
        && getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.storeId == request.resource.data.storeId
        && getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.appointmentDate == request.resource.data.appointmentDate
        && getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.appointmentTime == request.resource.data.appointmentTime
        && getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.capturedByUid == request.resource.data.capturedByUid;
      allow update: if activeUser()
        && resource.data.leadId == request.resource.data.leadId
        && validAppointmentSlot(slotId, request.resource.data)
        && (isAdmin() || managerHasStore(request.resource.data.storeId) || (
          userHasStore(request.resource.data.storeId)
          && request.resource.data.capturedByUid == request.auth.uid
        ))
        && existsAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId))
        && getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.storeId == request.resource.data.storeId
        && getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.appointmentDate == request.resource.data.appointmentDate
        && getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.appointmentTime == request.resource.data.appointmentTime
        && getAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.capturedByUid == request.resource.data.capturedByUid;
      allow delete: if isAdmin()
        || (activeUser() && (
          (hasPermission('leads.delete')
            && (resource.data.capturedByUid == request.auth.uid || managerHasStore(resource.data.storeId))
            && !existsAfter(/databases/$(database)/documents/leads/$(resource.data.leadId)))
          || (resource.data.capturedByUid == request.auth.uid
            && (
              !existsAfter(/databases/$(database)/documents/leads/$(resource.data.leadId))
              || getAfter(/databases/$(database)/documents/leads/$(resource.data.leadId)).data.appointmentDate != resource.data.appointmentDate
              || getAfter(/databases/$(database)/documents/leads/$(resource.data.leadId)).data.appointmentTime != resource.data.appointmentTime
              || getAfter(/databases/$(database)/documents/leads/$(resource.data.leadId)).data.appointmentDurationMinutes != resource.data.durationMinutes
            ))
        ));
    }

    match /appointmentReminders/{reminderId} {
      allow get, list: if isAdmin()
        || (managerHasStore(resource.data.storeId) && hasPermission('appointments.view'));
      allow create: if validAppointmentReminder(request.resource.data)
        && (isAdmin() || (managerHasStore(request.resource.data.storeId) && hasPermission('appointments.view')));
      allow update: if validAppointmentReminder(request.resource.data)
        && request.resource.data.leadId == resource.data.leadId
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.appointmentDate == resource.data.appointmentDate
        && request.resource.data.appointmentTime == resource.data.appointmentTime
        && request.resource.data.appointmentKey == resource.data.appointmentKey
        && (isAdmin() || (managerHasStore(resource.data.storeId) && hasPermission('appointments.view')));
      allow delete: if isAdmin()
        || (managerHasStore(resource.data.storeId) && hasPermission('appointments.view'));
    }

    match /goals/{goalId} {
      allow get, list: if activeUser() && (
        (resource.data.assigneeUid == request.auth.uid && hasPermission('goals.view_own'))
        || (managerHasStore(resource.data.storeId) && hasPermission('goals.manage'))
        || isAdmin()
      );

      allow create: if canManageGoals()
        && validGoal(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.role == 'captor'
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.storeId == request.resource.data.storeId
        && (isAdmin() || managerHasStore(request.resource.data.storeId));

      allow update: if canManageGoals()
        && validGoal(request.resource.data)
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.assigneeUid == resource.data.assigneeUid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.role == 'captor'
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.storeId == request.resource.data.storeId
        && (isAdmin() || (
          managerHasStore(resource.data.storeId)
          && managerHasStore(request.resource.data.storeId)
        ));
      allow delete: if isAdmin()
        || managerHasStore(resource.data.storeId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
