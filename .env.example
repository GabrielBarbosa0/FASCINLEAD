VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Use apenas durante o desenvolvimento local.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIRESTORE_EMULATOR_PORT=8180
VITE_FUNCTIONS_EMULATOR_PORT=5001

# Opcional no desenvolvimento local. Em producao, a sincronizacao e habilitada automaticamente.
VITE_ENABLE_ACCESS_SYNC=false

# Consulta SavWin somente no servidor local do Vite. Nunca use prefixo VITE_ nestas chaves.
SAVWIN_API_BASE_URL=https://cliapi.savwinweb.com.br
SAVWIN_IDENTIFICADOR=
SAVWIN_AUTHORIZATION=
SAVWIN_TIMEOUT_SECONDS=30

# API local para integracao servidor-a-servidor com CRMs. Use um token aleatorio
# com pelo menos 32 caracteres e nunca adicione estas credenciais ao Git.
FASCINLEAD_API_TOKEN=
FASCINLEAD_API_FIREBASE_PROJECT_ID=fascinlead
FASCINLEAD_API_ALLOWED_STORES=loja-02,loja-04,loja-05,loja-06
FASCINLEAD_API_SERVICE_ACCOUNT_JSON=
FASCINLEAD_API_FIRESTORE_EMULATOR_HOST=
FASCINLEAD_API_SENSITIVE_FIELDS=false
